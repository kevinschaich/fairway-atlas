{
  "name": "fairway-atlas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/audio-manifest.mjs && tsc -b && vite build",
